<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="pizzeria.presentation.controller.RegisterController"
  styleClass="auth-root"
  prefWidth="800" prefHeight="600">

  <VBox alignment="CENTER" spacing="16" maxWidth="430">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="UrPizza" styleClass="auth-logo"
      style="-fx-font-size: 48px; -fx-font-weight: 900;"/>
    <Label text="Реєстрація" styleClass="auth-subtitle"
      style="-fx-font-size: 20px; -fx-font-weight: 700;"/>

    <VBox spacing="10">
      <TextField fx:id="nameField" promptText="Ім'я" styleClass="text-field"/>
      <TextField fx:id="emailField" promptText="Email" styleClass="text-field"/>
      <TextField fx:id="phoneField" promptText="Телефон (напр. +380501234567)" styleClass="text-field"/>
      <PasswordField fx:id="passwordField" promptText="Пароль (мін. 6 символів)" styleClass="text-field"/>
      <PasswordField fx:id="confirmPasswordField" promptText="Підтвердити пароль" styleClass="text-field"/>
    </VBox>

    <Button text="ЗАРЕЄСТРУВАТИСЬ" onAction="#handleRegister" maxWidth="Infinity" styleClass="primary-button"/>

    <HBox alignment="CENTER" spacing="8">
      <Label text="Вже є акаунт?" styleClass="auth-muted"/>
      <Hyperlink text="Увійти" onAction="#backToLogin"/>
    </HBox>

    <Label fx:id="statusLabel" wrapText="true" alignment="CENTER"/>
  </VBox>
</StackPane>
