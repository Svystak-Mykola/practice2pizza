<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="pizzeria.presentation.controller.MenuController"
  styleClass="content-root" spacing="0">

  <VBox styleClass="page-header" spacing="4">
    <Label text="МЕНЮ" styleClass="page-title"/>
    <Label fx:id="menuSubtitle" text="Обери свою піцу" styleClass="page-subtitle"/>
  </VBox>

  <VBox styleClass="menu-toolbar" spacing="14">
    <TextField fx:id="searchField" promptText="🔍  Пошук піци..." styleClass="search-bar"
      onKeyReleased="#onSearch"/>
    <HBox fx:id="categoryBar" spacing="8" alignment="CENTER_LEFT"/>
  </VBox>

  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER">
    <FlowPane fx:id="menuGrid" hgap="20" vgap="20" styleClass="menu-grid"
      alignment="TOP_LEFT"/>
  </ScrollPane>
</VBox>
